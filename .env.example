# ==============================================================================
# USB-Stream-TV — Exemplo de Configurações de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas próprias credenciais:
#   cp .env.example .env
# ==============================================================================

# Porta e Segurança do Painel de Controle
PORT=8080
TV_PIN=1233
STANDBY_TIMEOUT=90.0

# Resolução de Transcodificação para Samsung Plasma PL51F4000 (1080p ou 720p)
STREAM_RESOLUTION=1080p

# Caminhos de Arquivos e Diretórios Locais
CHANNELS_FILE=channels.json
MOVIES_DIR=filmes

# VOD: deixe vazio para manter armazenamento local.
# Com Drive, use: docker compose -f compose.yaml -f compose.gdrive.yaml up -d --build
# Exemplo de remote já autorizado no rclone: gdrive:USB-Stream-TV/VOD
VOD_GDRIVE_REMOTE=
# Diretório privado contendo rclone.conf. Não commitar nem copiar para a imagem.
RCLONE_CONFIG_DIR=/caminho/privado/rclone
VOD_GDRIVE_CACHE_MB=128
# Cache descartável de apenas um vídeo na VPS; biblioteca permanente no Drive.
VOD_CURRENT_CACHE_GB=6
# Reserva de espaço para sistema/cache durante preparação dos novos VODs.
VOD_MIN_FREE_GB=8

# Credenciais do Provedor IPTV (Xtream Codes API)
XTREAM_UPSTREAM=http://seu-servidor-iptv.com:80
XTREAM_USER=seu_usuario_aqui
XTREAM_PASS=sua_senha_aqui

# Proxy Residencial (Opcional - deixe vazio se não utilizar)
RESIDENTIAL_HTTP_PROXY=
RESIDENTIAL_SOCKS_PROXY=

# ==============================================================================
# Mídia mista (pendrive virtual) — aplicação manual pelo botão "NA TV"
# ==============================================================================
# Comando (forma de lista, SEM shell) que publica uma geração. Deixe vazio para
# manter o VOD antigo: nesse caso o botão continua com o comportamento legado.
# Exemplo local: MIXED_APPLY_CMD=python3 /app/scripts/mixed_generation_service.py
# Preferir a ponte (MIXED_BRIDGE_SPOOL) quando o publicador vive em outro host.
MIXED_APPLY_CMD=
# Ponte container -> publicador: diretório compartilhado (0700) montado no
# container e no host que tem adb. O container NÃO precisa de adb/ssh: ele só
# deposita um pedido assinado pelo dono (uid) e lê a resposta. O host roda:
#   python3 scripts/mixed_bridge.py serve --spool /var/lib/usb-stream-tv/bridge \
#       --client-uid <uid-do-container> --publisher python3 /opt/usb-stream-tv/scripts/mixed_generation_service.py
# e MIXED_STATE_FILE deve apontar para o mesmo spool (estado compartilhado).
MIXED_BRIDGE_SPOOL=
# Diário de estado (gerações ativa/pendente, progresso da aplicação).
MIXED_STATE_FILE=scratch/mixed_generation_state.json
# Diretório de trabalho onde o comando acima é executado.
MIXED_APP_DIR=

# Nome do dono da lease exclusiva (ModeGuard) usada durante a troca do pendrive.
MIXED_GUARD_OWNER=mixed-publisher
# Validade da lease em segundos (15 a 120). Renovada durante a publicação.
MIXED_GUARD_TTL=60

# Script que troca a geração no servidor de mídia (Live manager + proxy VOD).
MIXED_VPS_SWITCH_SCRIPT=scripts/switch_mixed_generation_vps.sh
MIXED_VPS_SWITCH_ROOT=
MIXED_VPS_UPSTREAM=
MIXED_VPS_APP_DIR=
# Quando o publicador roda em outro host (ex.: hop SSH), o pacote validado é
# enviado (tar+scp), extraído e re-verificado por SHA256SUMS nesse host antes da
# troca de geração. Estes caminhos são os do host remoto, nunca do container.
MIXED_VPS_PACKAGE_ROOT=/var/lib/usb-stream-tv/generations
MIXED_VPS_SWITCH_SCRIPT_REMOTE=scripts/switch_mixed_generation_vps.sh
