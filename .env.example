# ==============================================================================
# USB-Stream-TV — Exemplo de Configurações de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas próprias credenciais:
#   cp .env.example .env
# ==============================================================================

# Porta e Segurança do Painel de Controle
PORT=8080
TV_PIN=1233
STANDBY_TIMEOUT=90.0

# Resolução de Transcodificação para Samsung Plasma PL51F4000 (1080p ou 720p)
STREAM_RESOLUTION=1080p

# Caminhos de Arquivos e Diretórios Locais
CHANNELS_FILE=channels.json
MOVIES_DIR=filmes

# VOD: deixe vazio para manter armazenamento local.
# Com Drive, use: docker compose -f compose.yaml -f compose.gdrive.yaml up -d --build
# Exemplo de remote já autorizado no rclone: gdrive:USB-Stream-TV/VOD
VOD_GDRIVE_REMOTE=
# Diretório privado contendo rclone.conf. Não commitar nem copiar para a imagem.
RCLONE_CONFIG_DIR=/caminho/privado/rclone
VOD_GDRIVE_CACHE_MB=128
# Cache descartável de apenas um vídeo na VPS; biblioteca permanente no Drive.
VOD_CURRENT_CACHE_GB=6
# Reserva de espaço para sistema/cache durante preparação dos novos VODs.
VOD_MIN_FREE_GB=8

# Credenciais do Provedor IPTV (Xtream Codes API)
XTREAM_UPSTREAM=http://seu-servidor-iptv.com:80
XTREAM_USER=seu_usuario_aqui
XTREAM_PASS=sua_senha_aqui

# Proxy Residencial (Opcional - deixe vazio se não utilizar)
RESIDENTIAL_HTTP_PROXY=
RESIDENTIAL_SOCKS_PROXY=
